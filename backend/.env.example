# ═══════════════════════════════════════════════════════════════════
# VoiceShield AI — Environment Configuration
# Copy to .env and fill in your values. ALL services are FREE.
# ═══════════════════════════════════════════════════════════════════

# ── Model ──────────────────────────────────────────────────────────
ONNX_MODEL_PATH=models/aasist_l.onnx
ONNX_THREADS=2

# ── Thresholds ─────────────────────────────────────────────────────
ADULT_THRESHOLD=0.85
CHILD_THRESHOLD=0.70

# ── Telegram (FREE — create bot at https://t.me/BotFather) ────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email SMTP (FREE — use your .edu.in Gmail App Password) ───────
# 1. Enable 2FA on your Google account
# 2. Go to Security → App Passwords → Generate
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@college.edu.in
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=guardian@example.com

# ── ntfy.sh (FREE — no signup needed, just pick a topic) ──────────
# Install the ntfy app on your phone for instant push notifications
NTFY_TOPIC=voiceshield-alerts
NTFY_SERVER=https://ntfy.sh

# ── Fast2SMS (FREE tier — sign up at https://www.fast2sms.com) ────
# Optional: only if you need SMS alerts to Indian numbers
FAST2SMS_API_KEY=
FAST2SMS_TO_NUMBER=

# ── Webhook (FREE — any endpoint you control) ─────────────────────
WEBHOOK_URL=

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173"]
