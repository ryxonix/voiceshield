# ═══════════════════════════════════════════════════════════════════
# VoiceShield AI — Environment Configuration
# Copy this file to `backend/.env` and fill in your values.
# ALL services are FREE — no credit card required.
# ═══════════════════════════════════════════════════════════════════

# ── Model ──────────────────────────────────────────────────────────
ONNX_MODEL_PATH=models/aasist_l.onnx
ONNX_THREADS=2

# ── Detection Thresholds ───────────────────────────────────────────
ADULT_THRESHOLD=0.85
CHILD_THRESHOLD=0.70

# ═══════════════════════════════════════════════════════════════════
#   🔑  ALERT / NOTIFICATION API KEYS
#   Add your free keys here. Each channel is OPTIONAL — leave any
#   value blank to disable that channel. Missing keys are simply
#   skipped at runtime (see backend/app/mitigation/alerts.py).
# ═══════════════════════════════════════════════════════════════════

# ── Telegram (FREE — create a bot at https://t.me/BotFather) ───────
#   1. Open Telegram  ->  message @BotFather  ->  /newbot
#   2. Copy the bot token into TELEGRAM_BOT_TOKEN
#   3. Add your bot to a chat/group, send one message, then visit
#      https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates to read
#      your chat id, and paste it into TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Email SMTP (FREE — use your .edu.in Gmail App Password) ────────
#   1. Enable 2FA on your Google account
#   2. Google Account -> Security -> App Passwords -> Generate
#   3. Use the 16-char app password here (not your real password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.name@college.edu.in
SMTP_PASSWORD=your_app_password_here
ALERT_EMAIL_TO=guardian@example.com

# ── ntfy.sh (FREE — no signup needed, just pick a topic) ──────────
#   Install the ntfy app on your phone for instant push notifications.
#   You can use the public server https://ntfy.sh or self-host.
#   Leave blank to disable push alerts (default).
NTFY_TOPIC=
NTFY_SERVER=https://ntfy.sh

# ── Fast2SMS (FREE tier — sign up at https://www.fast2sms.com) ─────
#   Indian SMS gateway. Free credits are included on signup.
#   Optional: only needed for SMS alerts to Indian mobile numbers.
FAST2SMS_API_KEY=
FAST2SMS_TO_NUMBER=

# ── Webhook (FREE — any endpoint you control) ─────────────────────
#   Example: https://hooks.slack.com/services/xxx or a self-hosted URL
WEBHOOK_URL=

# ── DoT Sanchar Saathi / Chakshu / DIP escalation (FREE, optional) ─
#   Downstream "suspected fraud" hand-off. If you have a receiver that
#   routes flagged-call metadata into the Digital Intelligence Platform
#   (DIP) / Chakshu for network-level action, paste its webhook URL here.
#   When set, every threshold-crossing alert is ALSO posted there with a
#   `channel: "chakshu_dip"` payload. Leave blank to disable.
#   NOTE: Chakshu/DIP are citizen-facing DoT portals (no public API) —
#   this is YOUR documented integration endpoint that feeds them.
CHAKSHU_DIP_WEBHOOK_URL=

# ── Contextual Enrichment (optional, SIH26104) ─────────────────────
# Adds conservative risk modifiers on top of the acoustic score using
# call metadata (caller, origin, transaction value, known-contact,
# historical fraud flags). OFF by default so pure acoustic behavior is
# unchanged; fail-open when no context is supplied.
CONTEXTUAL_ENRICHMENT=false
# Editable mitigation workflow rules (role × risk-band → actions/channels).
# Path is relative to backend/ when not absolute; set to "" for bundled
# defaults. Banks/enterprises/gov can edit without a code deploy.
WORKFLOWS_PATH=workflows.json

# ── Resend Email API (FREE tier — https://resend.com) ──────────────
#   Optional alternative to Gmail SMTP for transactional email.
RESEND_API_KEY=

# ── Sentry Error Tracking (FREE tier — https://sentry.io) ──────────
#   Optional. Leave blank to disable error monitoring.
SENTRY_DSN=

# ═══════════════════════════════════════════════════════════════════
#   ⛓  BLOCKCHAIN REPORT LEDGER  —  NBF EXTERNAL ANCHOR IS MANDATORY
#   The forensic-report ledger is a LOCAL proof-of-work hash chain — no
#   external API key (see backend/app/blockchain/).
# ═══════════════════════════════════════════════════════════════════
BLOCKCHAIN_DIFFICULTY=4

#   NBF-Lite / MeitY National Blockchain Framework external anchor is
#   MANDATORY by default (fail-closed):
#     BLOCKCHAIN_EXTERNAL_ANCHOR=true  -> use the real Hyperledger Fabric +
#                                         IPFS provider (NOT the demo shadow).
#     BLOCKCHAIN_ANCHOR_REQUIRED=true  -> a forensic report is written to the
#                                         local ledger ONLY AFTER the on-chain
#                                         anchor succeeded. Gateway/provider
#                                         failures raise BlockAnchorError; the
#                                         report endpoints refuse (503), and
#                                         verification reports the call as NOT
#                                         blockchain-anchored. No unanchored
#                                         evidence can be handed off.
#   Free deployment: Oracle Cloud Free Tier / WSL2 Ubuntu + Docker; set
#   NBF_GATEWAY_URL to the REST bridge (deploy/nbf-fabric/, default :4000).
#   Verify the public anchor (on-chain record + IPFS round-trip + %PDF):
#     GET /api/blockchain/onchain/{call_id}   (single report)
#     GET /api/blockchain/onchain             (summary of all anchors)
#
#   OFFLINE DEV / DEMO ONLY (laptop with no Fabric node): explicitly disable
#   BOTH flags below. The local DemoAnchor shadow then records the same
#   payload with status 'demo' (never 'anchored'), but the report endpoints
#   do NOT claim blockchain anchoring. Do not hand off demo reports as
#   forensic evidence.
BLOCKCHAIN_EXTERNAL_ANCHOR=true
BLOCKCHAIN_ANCHOR_REQUIRED=true
NBF_GATEWAY_URL=http://127.0.0.1:4000
NBF_CHANNEL=mychannel
NBF_CC=voiceshield-report
NBF_USER=User1
NBF_MSP=Org1MSP
NBF_CFGPATH=
# How /retrieve payloads map to the anchor ciphertext (see external_anchor.py):
#   auto        -> self-detect per fetch (recommended; works with our gateway
#                  and with the official NBFLite samplerest gateway)
#   raw         -> our trimmed gateway (decoded bytes pinned)
#   base64text  -> NBFLite sample gateway (base64 *text* pinned)
NBF_IPFS_MODE=auto
IPFS_STORE_URL=
REPORT_KEYS_DIR=
# ═══════════════════════════════════════════════════════════════════
#   🤗  DATA / MODEL SOURCES
# ═══════════════════════════════════════════════════════════════════

# ── Hugging Face (FREE — https://huggingface.co/settings/tokens) ───
#   Used ONLY to download open FLEURS (CC-BY-4.0) training data and to
#   fetch the Ayush2635 Dhwani pretrained model (MIT weights).
#   The public FLEURS parquet files download fine without a token.
HF_TOKEN=

# ── Neon PostgreSQL (FREE serverless tier) ─────────────────────────
#   Optional. Used for multi-machine incident/telemetry persistence.
#   Leave blank for an in-memory store (fully ephemeral & DPDP-safe).
DATABASE_URL=

# ── Server ─────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]